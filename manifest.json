{
  "manifest_version": 3,
  "name": "Inbox Blinders",
  "version": "0.2.1",
  "description": "Hide your inbox so you can compose without distraction. Click the toolbar icon (or use Cmd+Shift+B) to toggle. Supports Gmail and Superhuman.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://mail.superhuman.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Toggle Inbox Blinders",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://mail.superhuman.com/*"
      ],
      "js": ["content.js"],
      "css": ["hide.css"],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "toggle-blinders": {
      "suggested_key": {
        "default": "Ctrl+Shift+B",
        "mac": "Command+Shift+B"
      },
      "description": "Toggle Inbox Blinders on/off"
    }
  }
}
